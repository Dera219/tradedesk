# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Alpaca: PAPER TRADING ONLY -------------------------------------------------
# Generate at https://app.alpaca.markets/paper/dashboard/overview
#
# The base URL below must stay pointed at paper-api. Alpaca uses the same key format
# for live and paper accounts, so a live key pasted here would simply work — and
# place real orders with real money. There is no error message for that mistake.
# If you ever hold live credentials, keep them in a separate profile entirely.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- LLM ------------------------------------------------------------------------
# Only needed for the real (non-offline) classifier. The demo runs without a key on the keyword
# classifier; set TRADEDESK_LLM_CLASSIFIER=1 to switch to the Claude-backed one.
ANTHROPIC_API_KEY=
TRADEDESK_LLM_CLASSIFIER=0
MODEL_ID=claude-opus-4-8

# --- RAG ------------------------------------------------------------------------
VECTOR_STORE_PATH=./.chroma
CORPUS_PATH=./corpus
# Below this retrieval score, the agent says "not in my docs" rather than guessing.
# Tune against real questions; a too-low threshold is how confident wrong answers happen.
RETRIEVAL_MIN_SCORE=0.35

# --- Safety ---------------------------------------------------------------------
# Server-side allowlist. The classifier may extract any ticker; only these execute.
SYMBOL_ALLOWLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,TSLA,SPY,QQQ
MAX_ORDER_QUANTITY=100
